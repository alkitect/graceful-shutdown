# Graceful shutdown when idle + low CPU/GPU load + low bulk network.
# Copy to: ~/.config/graceful-shutdown/config (install-to-local.sh seeds this)

# Must be 1 before any real poweroff (safety gate).
POWEROFF_ENABLED=0

# No mouse/keyboard for this long before low-load streak can start (default 1 min).
INPUT_IDLE_SEC=60

# Continuous low CPU/GPU streak after input idle (default 14 min → 15 min total).
# Busy load/net/backup pauses this clock (does not wipe progress).
LOW_LOAD_STREAK_SEC=840

# Max CPU/GPU utilization (percent) — enter busy above these.
CPU_MAX_PCT=10
GPU_MAX_PCT=15

# Hysteresis idle floors — leave busy only at/below these for HYSTERESIS_OK_POLLS polls.
CPU_IDLE_PCT=7
GPU_IDLE_PCT=10
HYSTERESIS_OK_POLLS=2

# Optional: pin DRM card for GPU metrics on dual-GPU hosts (e.g. card1). Empty = max across cards.
GPU_DRM_CARD=

# VRAM via rocm-smi (can hang under lock). Prefer 0; sysfs gpu_busy is enough.
GPU_CHECK_VRAM=0
GPU_VRAM_MAX_PCT=90

# Legacy strike counter (kept for compatibility; busy load uses streak pause + hysteresis).
HIGH_LOAD_POLLS_TO_RESET=2

# Soft load window (sample history). Not wall-clock time.
# 0 = hysteretic per-poll thresholds.
LOAD_WINDOW_ENABLED=0
LOAD_WINDOW_POLLS=8
LOAD_WINDOW_MAX_HIGH=1
# Used only if LOAD_WINDOW_MAX_HIGH is unset/non-numeric.
LOAD_WINDOW_MIN_OK_FRAC=95
# frac | avg | both — default avg absorbs single GPU blips.
LOAD_WINDOW_METRIC=avg
LOAD_WINDOW_REQUIRE_FULL=1

# Bulk network stay-awake (bytes/sec). Ignores low chatter (games/chat).
NET_CHECK_ENABLED=1
NET_RX_MIN_BPS=204800
NET_TX_MIN_BPS=204800
NET_BUSY_POLLS=2
# Empty = auto default-route iface (VPN-safe: uses the tunnel when a VPN owns the route).
# Set to pin a device (e.g. wlan0). Never sums multiple ifaces.
NET_IFACE=

# Pause streak while Ubuntu Backup work is active (unit and/or duplicity).
BACKUP_CHECK_ENABLED=1
# 0 (default) = ignore lone deja-dup --backup/--restore waiting on UI dialogs.
# 1 = legacy: any non-gapplication-service deja-dup counts as busy.
BACKUP_TREAT_UI_PROCESS=0

# Warning period after eligible before poweroff (seconds).
GRACE_SEC=120

# Seconds between /proc/stat samples for CPU averaging.
CPU_SAMPLE_SEC=3

# Timeout for gdbus / rocm-smi (seconds).
EXT_CMD_TIMEOUT_SEC=5

# Logging
LOG_HEARTBEAT=1
LOG_ALWAYS_SAMPLE_LOAD=1
LOG_STREAK_MILESTONE_SEC=120
LOG_POLL_GAP_WARN_SEC=90

LOG_FILE=${XDG_STATE_HOME:-$HOME/.local/state}/graceful-shutdown/check.log
LOG_TO_JOURNAL=1
LOG_MAX_LINES=2000

DRY_RUN=0
